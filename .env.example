# Copy to .env (scripts/init.sh does this and generates the API key/secret).

# --- Versions (pinned; bump deliberately) ---
LIVEKIT_VERSION=v1.13.9
SIP_VERSION=v1.18.0
LK_CLI_VERSION=v2.18.8
# Call recording (egress service). Checked against LIVEKIT_VERSION above.
EGRESS_VERSION=v1.15.0

# Non-default port so it never clashes with another Redis on the host.
REDIS_PORT=6380
# Dashboard (localhost only; use `make tunnel`). Log in with `make dashboard-admin` credentials.
DASHBOARD_PORT=8787
# Generated by scripts/init.sh. Keep it secret; changing it logs everyone out.
DJANGO_SECRET_KEY=
# Never true on the VM: debug pages show settings and caller data.
DJANGO_DEBUG=false

# --- Dashboard database (PostgreSQL, localhost only) ---
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
# Generated by scripts/init.sh. Set before the first `make up`: the database is created with it.
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- LiveKit credentials (generated by scripts/init.sh) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Agents on the same VM use localhost; agents on other VMs use the media VM's private IP.
LIVEKIT_URL=ws://127.0.0.1:7880

# --- SIP trunk (from your provider) ---
# Comma-separated, E.164 format.
SIP_NUMBERS=+91XXXXXXXXXX
# Comma-separated IPs/CIDRs your provider sends calls from.
SIP_ALLOWED_ADDRESSES=
# Optional digest auth, if your provider uses it for inbound calls.
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
SIP_LOG_LEVEL=info
# Public IP of the LiveKit SIP server. scripts/test-call.sh dials it over SIP directly
# (Twilio trial accounts can only dial verified phone numbers).
AGENT_SIP_HOST=

# --- Agent ---
AGENT_NAME=phone-agent
# gemini-live: Gemini speech-to-speech, needs only GOOGLE_API_KEY.
# sarvam:      Sarvam STT + OpenAI LLM + Sarvam TTS, needs SARVAM_API_KEY + OPENAI_API_KEY.
# elevenlabs:  Sarvam STT + OpenAI LLM + ElevenLabs TTS, also needs ELEVEN_API_KEY.
AGENT_PIPELINE=gemini-live

GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Tone follows the caller's emotion (Gemini v1alpha). Try true if supported by your model.
GEMINI_AFFECTIVE_DIALOG=false
AGENT_PERSONA_NAME=Priya
# none | office | callcenter | city | path to your own audio file (relative to agent/).
# Avoid office: its clip has people talking, which callers hear as someone else on the line.
BACKGROUND_AMBIENCE=none
# Optional: override the background level (each built-in has a tuned default).
BACKGROUND_VOLUME=
# Caller silence: check in after NUDGE_S and SECOND_NUDGE_S, hang up politely after HANG_UP_S.
# Saying "ek minute", "ruko", "wait"… triples these for that silence.
DEAD_AIR_ENABLED=true
DEAD_AIR_NUDGE_S=4
DEAD_AIR_SECOND_NUDGE_S=9
DEAD_AIR_HANG_UP_S=15
# Caller mood: classify each caller turn and adapt tone (and pace on sarvam/elevenlabs).
# Off until the accuracy check passes. SENTIMENT_MODEL empty = gemini-flash-lite-latest on
# gemini-live (GOOGLE_API_KEY), gpt-4.1-mini otherwise (OPENAI_API_KEY).
MOOD_ENABLED=false
SENTIMENT_MODEL=
# Keep caller turn text in call reports for labelling. Turn off after the evaluation.
MOOD_EVAL_CAPTURE=false
# Live transfer to a telecaller (tel:+91XXXXXXXXXX or sip:…) when an upset driver agrees.
# Needs a SIP trunk that supports call transfer (REFER). Empty = off; the agent offers a callback.
HANDOFF_SIP_URI=
# Send each call's outcome, mood, dead air and latency to the dashboard. On the media VM:
# http://127.0.0.1:8787/api/report. On separate agent VMs, leave empty (the dashboard is localhost-only).
DASHBOARD_REPORT_URL=
# Where the agent fetches the published agent config and posts live events (/api/runtime/*).
# Empty = derived from DASHBOARD_REPORT_URL. Last good config per number is cached in CONFIG_CACHE_DIR.
DASHBOARD_URL=http://127.0.0.1:8787
CONFIG_CACHE_DIR=/cache
# Call recording master switch. true: phone calls are recorded when the workspace's "Record calls" switch
# (console Settings -> Calls) is on; the caller hears the consent line only if recording actually started.
# false: nothing is recorded, whatever the console says.
RECORDING_ENABLED=true
# Console "Try it" / "Test call" text simulator (agent-sim service, uses GOOGLE_API_KEY).
# The dashboard reaches it at AGENT_SIM_URL; both run on the media VM.
SIM_PORT=8790
SIM_LLM_MODEL=gemini-2.5-flash
AGENT_SIM_URL=http://127.0.0.1:8790
# Workflow builder "Suggest with AI" (dashboard service, uses GOOGLE_API_KEY): the Gemini model and how many runs
# each workspace may start per day (failed runs don't count).
SUGGEST_LLM_MODEL=gemini-3.6-flash
SUGGEST_DAILY_LIMIT=20
# Call audits (dashboard service, uses GOOGLE_API_KEY): Gemini scores the AI side of finished calls once a workspace
# turns them on (Settings → Call handling). Empty model = SUGGEST_LLM_MODEL. Audits run in background threads; this
# many at once per dashboard process. `manage.py audit_sweep` re-runs audits a restart left stuck.
AUDIT_LLM_MODEL=
AUDIT_MAX_CONCURRENT=2
# Console "Voice test" (talk to the draft in the browser over WebRTC, no SIP call): the LiveKit URL the
# browser connects to. `make tunnel` forwards 7880, so the default works from your laptop.
LIVEKIT_PUBLIC_URL=ws://localhost:7880

SARVAM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Default reply language until the caller's language is detected.
DEFAULT_LANGUAGE=hi-IN
TTS_SPEAKER=priya

ELEVEN_API_KEY=
# Default is Sarah (premade). Hindi library voices (e.g. Muskaan xoV6iGVuOGYHLWjXhVC7,
# Riya Rao mActWQg9kibLro6Z2ouY) need a paid ElevenLabs plan to use over the API.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
# Warm processes ready for new calls. Use 1 on small VMs (e2-medium), 3+ on 4+ vCPU.
NUM_IDLE_PROCESSES=3
LOAD_THRESHOLD=0.75

# Where Django's "/" page redirects: the Next.js console (the console service, reached via `make tunnel`).
CONSOLE_URL=http://localhost:3000/
# Extra origins allowed to POST to Django, comma-separated, beyond http://localhost:3000 and
# http://127.0.0.1:3000 (e.g. a console on another port). Leave empty normally.
CSRF_EXTRA_TRUSTED_ORIGINS=
