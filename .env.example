# Copy to .env (scripts/init.sh does this and generates the API key/secret).

# --- Versions (pinned; bump deliberately) ---
LIVEKIT_VERSION=v1.13.9
SIP_VERSION=v1.18.0
LK_CLI_VERSION=v2.18.8

# Non-default port so it never clashes with another Redis on the host.
REDIS_PORT=6380
# Dashboard (localhost only; use `make tunnel`). Log in with `make dashboard-admin` credentials.
DASHBOARD_PORT=8787
# Generated by scripts/init.sh. Keep it secret; changing it logs everyone out.
DJANGO_SECRET_KEY=
# Never true on the VM: debug pages show settings and caller data.
DJANGO_DEBUG=false

# --- LiveKit credentials (generated by scripts/init.sh) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Agents on the same VM use localhost; agents on other VMs use the media VM's private IP.
LIVEKIT_URL=ws://127.0.0.1:7880

# --- SIP trunk (from your provider) ---
# Comma-separated, E.164 format.
SIP_NUMBERS=+91XXXXXXXXXX
# Comma-separated IPs/CIDRs your provider sends calls from.
SIP_ALLOWED_ADDRESSES=
# Optional digest auth, if your provider uses it for inbound calls.
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
SIP_LOG_LEVEL=info
# Public IP of the LiveKit SIP server. scripts/test-call.sh dials it over SIP directly
# (Twilio trial accounts can only dial verified phone numbers).
AGENT_SIP_HOST=

# --- Agent ---
AGENT_NAME=phone-agent
# gemini-live: Gemini speech-to-speech, needs only GOOGLE_API_KEY.
# sarvam:      Sarvam STT + OpenAI LLM + Sarvam TTS, needs SARVAM_API_KEY + OPENAI_API_KEY.
# elevenlabs:  Sarvam STT + OpenAI LLM + ElevenLabs TTS, also needs ELEVEN_API_KEY.
AGENT_PIPELINE=gemini-live

GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Tone follows the caller's emotion (Gemini v1alpha). Try true if supported by your model.
GEMINI_AFFECTIVE_DIALOG=false
AGENT_PERSONA_NAME=Priya
# office | callcenter | city | none | path to your own audio file (relative to agent/)
BACKGROUND_AMBIENCE=office
# Optional: override the background level (each built-in has a tuned default).
BACKGROUND_VOLUME=
# Caller silence: check in after NUDGE_S and SECOND_NUDGE_S, hang up politely after HANG_UP_S.
# Saying "ek minute", "ruko", "wait"… triples these for that silence.
DEAD_AIR_ENABLED=true
DEAD_AIR_NUDGE_S=4
DEAD_AIR_SECOND_NUDGE_S=9
DEAD_AIR_HANG_UP_S=15

SARVAM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Default reply language until the caller's language is detected.
DEFAULT_LANGUAGE=hi-IN
TTS_SPEAKER=priya

ELEVEN_API_KEY=
# Default is Sarah (premade). Hindi library voices (e.g. Muskaan xoV6iGVuOGYHLWjXhVC7,
# Riya Rao mActWQg9kibLro6Z2ouY) need a paid ElevenLabs plan to use over the API.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
# Warm processes ready for new calls. Use 1 on small VMs (e2-medium), 3+ on 4+ vCPU.
NUM_IDLE_PROCESSES=3
LOAD_THRESHOLD=0.75
