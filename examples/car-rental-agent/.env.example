# Agent identity for the Northwind Car Rentals example. Add these to agent/.env (or the repo .env).
# They are the worker-wide defaults: a published agent's own values (persona_name and
# settings.company_name / name_pronunciation / consent_line in agent.json) win over them.
# Leave a variable unset to keep the prompt generic.

# The company the agent calls for. Unset: no company is named.
AGENT_COMPANY_NAME=Northwind Car Rentals
# The name the agent introduces itself with. Unset: the agent gives no name.
AGENT_PERSONA_NAME=Maya
# How to say the company name (added to the system prompt). Unset: no pronunciation rule.
AGENT_NAME_PRONUNCIATION='"NORTH-wind", stress on the first syllable; never "north-WIND".'
# Spoken after the opening line when the call is recorded. Unset: "This call is being recorded for
# quality purposes." Set it to an empty value to say no notice.
AGENT_CONSENT_LINE=Yeh call quality ke liye record ho rahi hai.
